<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="480.0" prefWidth="280.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.zmiko.onara.TaskController">
   <children>
      <ButtonBar prefHeight="40.0" prefWidth="358.0">
        <buttons>
            <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
            <Label prefHeight="18.0" prefWidth="149.0" text="Onara" />
          <Button fx:id="modeButton" onAction="#modeChange" minWidth="39.0" mnemonicParsing="false" prefHeight="30.0" prefWidth="392.0" text="Queue" />
        </buttons>
         <padding>
            <Insets left="-20.0" right="10.0" />
         </padding>
      </ButtonBar>
      <VBox alignment="BOTTOM_CENTER" prefHeight="430.0" prefWidth="280.0">
         <children>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <TextField fx:id="newTask" onAction="#newTask" prefHeight="28.0" prefWidth="225.0" promptText="New Tasks">
                     <padding>
                        <Insets left="10.0" />
                     </padding>
                  </TextField>
                  <Button mnemonicParsing="false" onAction="#newTask" prefHeight="28.0" prefWidth="110.0" text="add" />
               </children>
            </HBox>
            <VBox fx:id="tasksVb" alignment="TOP_CENTER" prefHeight="273.0" prefWidth="280.0">
               <VBox.margin>
                  <Insets />
               </VBox.margin>
               <padding>
                  <Insets top="20.0" />
               </padding>
            </VBox>
            <Button mnemonicParsing="false" onAction="#complete" prefHeight="51.0" prefWidth="222.0" text="Complete" />
         </children>
         <VBox.margin>
            <Insets bottom="20.0" />
         </VBox.margin>
      </VBox>
   </children>
</VBox>
